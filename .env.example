# PostgreSQL
DATABASE_URL="postgresql://marketlens:marketlens@localhost:5432/marketlens?schema=public"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ENABLE_AUTH=false
ENABLE_AI=false
MAX_RESEARCH_RESULTS=250

# Providers
DEFAULT_PLACE_PROVIDER="openstreetmap"
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
OVERPASS_TIMEOUT_SECONDS=25
GOOGLE_MAPS_API_KEY=""

# Optional AI
DEFAULT_AI_PROVIDER=""
GEMINI_API_KEY=""

# Optional hosted authentication
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
