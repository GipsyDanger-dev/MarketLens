# Local Docker PostgreSQL. `marketlens init` generates a strong local password
# automatically; replace this development-only value before exposing any service.
PORT=3000
POSTGRES_PORT=5432
POSTGRES_DB=marketlens
POSTGRES_USER=marketlens
POSTGRES_PASSWORD=marketlens
DATABASE_URL="postgresql://marketlens:marketlens@localhost:5432/marketlens?schema=public"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ENABLE_AUTH=false
# Required only when ENABLE_AUTH=true. Generate a long random value and keep it
# secret; visitors enter it once at /access and receive an HttpOnly cookie.
MARKETLENS_ACCESS_TOKEN=""
ENABLE_AI=false
MAX_RESEARCH_RESULTS=250

# Providers
DEFAULT_PLACE_PROVIDER="openstreetmap"
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
OVERPASS_TIMEOUT_SECONDS=25
# Comma-separated, approved backup interpreter URLs. Leave blank when unused.
OVERPASS_FALLBACK_URLS=""
# Retries run only for timeout, rate-limit, and 5xx/network failures.
OVERPASS_MAX_RETRIES=1
OVERPASS_RETRY_DELAY_MILLISECONDS=750
# Optional Google Places (New); server-side only, never NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=""

# Google Maps Scraper (Playwright-based, no API key required)
# Set to 'google-maps-scraper' as DEFAULT_PLACE_PROVIDER to use
SCRAPER_TIMEOUT_MILLISECONDS=30000
SCRAPER_MAX_DEPTH=10
SCRAPER_LANG_CODE=en
SCRAPER_EXTRACT_EMAILS=false
SCRAPER_EXTRACT_EXTRA_REVIEWS=false

# Proxy configuration (optional, for scale scraping)
# Single proxy: http://user:pass@host:port
SCRAPER_PROXY_URL=""
# Multiple proxies for rotation: http://user:pass@host:port,socks5://host:port
SCRAPER_PROXY_LIST=""
# Enable rotation between proxies (requires SCRAPER_PROXY_LIST)
SCRAPER_PROXY_ROTATION=false

# Browser pooling and parallel scraping (optional, for performance)
# Maximum number of parallel scraping tasks (1-20, default: 5)
SCRAPER_CONCURRENCY=5
# Maximum number of browser instances in pool (1-10, default: 2)
SCRAPER_POOL_SIZE=2
# Maximum pages per browser instance (1-20, default: 5)
SCRAPER_MAX_PAGES_PER_BROWSER=5

# Optional AI
DEFAULT_AI_PROVIDER="gemini"
GEMINI_API_KEY=""
AI_TIMEOUT_MILLISECONDS=20000
AI_MAX_RETRIES=1

# Optional hosted authentication
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
