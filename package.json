{
  "name": "marketlens",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, self-hostable local business intelligence platform.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/providers/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@marketlens/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.17.0",
  "devDependencies": {
    "dotenv": "^17.3.1",
    "prisma": "^7.9.1"
  }
}
